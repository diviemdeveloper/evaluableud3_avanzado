<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PMDM · UT3"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activities, Intents y Layouts"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnEjercicio1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 1 · Validar URL"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEjercicio2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 2 · Navegación retrasada"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEjercicio3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 3 · LinearLayout anidados"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEjercicio4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 4 · FrameLayout"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEjercicio5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 5 · Calculadora (TableLayout)"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnEjercicio6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio 6 · Perfil (ConstraintLayout)" />
    </LinearLayout>
</ScrollView>